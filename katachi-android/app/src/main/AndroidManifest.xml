<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shared by the Lume apps; only apps signed with the same key hold it. -->
    <permission
        android:name="app.lume.permission.ECOSYSTEM_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="app.lume.permission.ECOSYSTEM_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets the solved count reach Kasane, and lets us see the other Lume apps. -->
    <queries>
        <package android:name="app.kasane" />
        <package android:name="app.ren.japanese" />
        <package android:name="com.sigil.app" />
        <package android:name="com.vow.app" />
        <package android:name="com.duolingo" />
    </queries>

    <application
        android:name=".KatachiApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Katachi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="katachi" android:host="puzzle" android:pathPrefix="/next" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".FloorModeReceiver"
            android:exported="true"
            android:permission="app.lume.permission.ECOSYSTEM_SYNC">
            <intent-filter>
                <action android:name="app.lume.action.FLOOR_MODE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TodayWidget"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <provider
            android:name=".StatusProvider"
            android:authorities="app.katachi.provider"
            android:exported="true"
            android:readPermission="app.lume.permission.ECOSYSTEM_SYNC"
            android:writePermission="app.lume.permission.ECOSYSTEM_SYNC" />
    </application>
</manifest>
